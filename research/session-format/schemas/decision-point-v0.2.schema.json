{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/li-yongqvan/experience-pack/research/session-format/schemas/decision-point-v0.2.schema.json",
  "title": "AI Collaboration Experience Package - Decision Point v0.2",
  "description": "Decision point with optional back-references to experience unit, session fragments, git evidence, and tags. Prototype / v0.2.",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "category_en",
    "source",
    "source_type",
    "question",
    "options",
    "selected_option",
    "rationale",
    "affected_files",
    "unresolved_tail",
    "timestamp",
    "related_commit"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+$",
      "description": "Globally unique decision point identifier"
    },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "任务定义",
        "方法选择",
        "范围取舍",
        "上下文注入",
        "提示精炼",
        "约束声明",
        "方向修正",
        "验收/终止"
      ]
    },
    "category_en": {
      "type": "string",
      "enum": [
        "task_definition",
        "method_selection",
        "scope_tradeoff",
        "context_injection",
        "prompt_refinement",
        "constraint_declaration",
        "course_correction",
        "acceptance_termination"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["grilling", "grilling-qa"]
    },
    "question": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["label", "consequence"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "consequence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "selected_option": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string" },
    "affected_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_tail": { "type": "string" },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "related_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "experience_unit_id": {
      "type": "string",
      "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+$",
      "description": "Owning experience unit"
    },
    "session_fragment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^frag-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+$"
      }
    },
    "git_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^git-[0-9a-f]{7,40}-[a-z0-9_.-]+$"
      }
    },
    "git_hunk_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^git-hunk-[0-9a-f]{7,40}-[a-z0-9_.-]+-[0-9]+$"
      },
      "description": "Hunk-level code evidence associated with this decision"
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      }
    },
    "related_message_uuids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "alignment_quality": {
      "type": "string",
      "enum": ["manual", "heuristic", "inferred"]
    }
  },
  "additionalProperties": false
}
