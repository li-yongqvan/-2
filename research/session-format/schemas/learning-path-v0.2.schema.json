{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/li-yongqvan/-2/research/session-format/schemas/learning-path-v0.2.schema.json",
  "title": "AI Collaboration Experience Package - Learning Path v0.2",
  "description": "A complete learning path composed of course modules or driven by tag filters. Prototype / v0.2.",
  "type": "object",
  "required": [
    "path_id",
    "title",
    "description",
    "entry_points",
    "modules"
  ],
  "properties": {
    "path_id": {
      "type": "string",
      "pattern": "^path-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Globally unique learning path identifier"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "label", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["module", "tag"]
          },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id"],
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^mod-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tag_filters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "description": "Optional tag-driven filter for dynamic path construction"
    },
    "estimated_duration_minutes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
