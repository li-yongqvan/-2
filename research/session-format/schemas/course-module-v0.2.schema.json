{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/li-yongqvan/-2/research/session-format/schemas/course-module-v0.2.schema.json",
  "title": "AI Collaboration Experience Package - Course Module v0.2",
  "description": "A themed learning module composed of experience units. Prototype / v0.2.",
  "type": "object",
  "required": [
    "module_id",
    "title",
    "description",
    "entry_type",
    "learning_objectives",
    "unit_sequence"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^mod-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Globally unique module identifier"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entry_type": {
      "type": "string",
      "enum": ["method", "timeline", "mixed"],
      "description": "Primary entry point type for this module"
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Prerequisite module ids or tag ids"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unit_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id"],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+$"
          },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "estimated_duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      }
    }
  },
  "additionalProperties": false
}
