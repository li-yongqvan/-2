---
import { unitDecision, tagLabel, formatDate } from '../data/loader.ts';
import type { ExperienceUnit } from '../data/loader.ts';

export interface Props {
  unit: ExperienceUnit;
}
const { unit } = Astro.props;
const decision = unitDecision(unit);
const base = import.meta.env.BASE_URL ?? '/';
---

<article class="unit-card">
  <div class="unit-card-header">
    <span class={`status-badge status-${unit.review_status}`}>{unit.review_status}</span>
    <a href={`${base}unit/${unit.unit_id}`} class="unit-title">
      {decision?.title ?? unit.unit_id}
    </a>
  </div>
  <p class="unit-question">{decision?.question ?? unit.reviewer_notes}</p>
  <div class="unit-meta">
    <span>📅 {formatDate(unit.created_at)}</span>
    {
      unit.tag_ids.length > 0 && (
        <span class="tag-list">
          {unit.tag_ids.map((id) => (
            <span class="tag-pill">{tagLabel(id)}</span>
          ))}
        </span>
      )
    }
  </div>
</article>
