---
export interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL ?? '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Dual Entry Prototype</title>
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        <a class="brand" href={`${base}`}>🧭 Dual Entry</a>
        <a href={`${base}by-method`}>按方法主题</a>
        <a href={`${base}by-project`}>按项目时间线</a>
        <a href={`${base}search`} class="nav-search" aria-label="搜索">🔍 搜索</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
